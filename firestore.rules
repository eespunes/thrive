rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user document: profile, the families they belong to and view state.
    // Strictly owner-only.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Unsaved changes set aside after a restart, kept apart from the family
      // data until the user applies or discards them. Owner-only.
      match /unsavedChanges/{changeId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Shared family workspace. `memberUids` is the source of truth for access.
    // All persistence is done directly from the client (no Cloud Functions);
    // the family join password is verified here, in rules, by comparing a
    // client-supplied proof against `joinHash`, which non-members can never
    // read because reads require membership.
    match /families/{familyId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function uid() {
        return request.auth.uid;
      }
      function isMember() {
        return isSignedIn()
          && resource.data.memberUids is list
          && uid() in resource.data.memberUids;
      }
      function isOwner() {
        return isSignedIn() && resource.data.ownerUid == uid();
      }
      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // The current owner may hand the family to another member as they leave:
      // ownership transfers to someone who is already a member and remains one,
      // and the departing owner drops their own membership. Nobody else can
      // change `ownerUid`. This keeps a family owned after its owner leaves
      // (issue #133) without ever letting a non-owner seize ownership.
      function isOwnerHandoff() {
        return isOwner()
          && request.resource.data.ownerUid != uid()
          && request.resource.data.ownerUid in resource.data.memberUids
          && request.resource.data.ownerUid in request.resource.data.memberUids
          && !(uid() in request.resource.data.memberUids);
      }

      // A non-owner member removing exactly themselves from `memberUids`
      // (leaving the family): the new list is one shorter, is a subset of the
      // old one, and no longer contains them — so the single removed uid can
      // only be their own. Combined with `isMember()` (they were in the old
      // list) nobody can use this branch to evict anyone else.
      function isSelfRemovalOnly() {
        return request.resource.data.memberUids.size()
                 == resource.data.memberUids.size() - 1
          && resource.data.memberUids.hasAll(request.resource.data.memberUids)
          && !(uid() in request.resource.data.memberUids);
      }

      // Keys a NON-OWNER member may touch on the shared doc: display fields,
      // the (cosmetic — real authority is `ownerUid`) members list, the legacy
      // single-doc `workspace` blob (kept until every client has migrated to
      // the workspace subcollection), post-join `joinProof` cleanup and the
      // update timestamps. Deliberately NOT included: `joinHash`, `joinSalt`,
      // `joinScheme`, `memberUids`, `ownerUid`, `username` — a non-owner must
      // never rotate the join credential or evict other members (only the
      // owner may, and self-removal goes through `isSelfRemovalOnly`).
      function memberSafeChange() {
        return changedKeys().hasOnly([
          'name', 'picture', 'members', 'workspace', 'joinProof',
          'updatedAt', 'updatedAtMillis',
        ]);
      }

      // A non-member joining must supply the correct password proof
      // (`joinProof == joinHash`) and may only append THEMSELVES to
      // `memberUids`. Ownership, the username handle, the join hash and the
      // shared workspace must all stay untouched by a joining client. The
      // joiner's display row in `members` is appended by a follow-up write
      // once they ARE a member; during the transition an old client may still
      // append it here, in which case `members` may only grow by exactly one.
      function isValidSelfJoin() {
        return isSignedIn()
          && resource.data.joinHash is string
          && request.resource.data.joinProof == resource.data.joinHash
          && !(uid() in resource.data.memberUids)
          && uid() in request.resource.data.memberUids
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size()
               == resource.data.memberUids.size() + 1
          && (!changedKeys().hasAny(['members'])
              || request.resource.data.members.size()
                   == resource.data.members.size() + 1)
          // A joiner may ONLY touch the membership arrays, their password proof
          // and the update timestamps. Restricting the changed keys this way
          // keeps ownership, the username handle, the join hash and the shared
          // workspace immutable WITHOUT deep-comparing the (potentially large)
          // workspace map — that comparison is both costly and brittle and was
          // rejecting otherwise-valid joins into data-rich families (issue #127).
          && changedKeys().hasOnly([
               'memberUids', 'members', 'joinProof',
               'updatedAt', 'updatedAtMillis',
             ]);
      }

      // Members can read the shared workspace.
      allow read: if isMember();

      // Create: the creator must be the owner and a member of their new family.
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.memberUids is list
        && uid() in request.resource.data.memberUids;

      // Update:
      //  - The OWNER may change anything except the username handle, and
      //    ownership only via a handoff as they leave.
      //  - Any other MEMBER may only touch the member-safe keys, or remove
      //    exactly themselves (leaving). They can never rotate the join
      //    credential, evict others or seize ownership (issue: security H1).
      //  - A NON-MEMBER may perform a password-verified self-join.
      allow update: if (isOwner()
          && request.resource.data.username == resource.data.username
          && (request.resource.data.ownerUid == resource.data.ownerUid
              || isOwnerHandoff()))
        || (isMember() && !isOwner()
          && !changedKeys().hasAny(['ownerUid', 'username'])
          && (memberSafeChange()
              || (isSelfRemovalOnly()
                  && changedKeys().hasOnly([
                       'memberUids', 'members', 'workspace',
                       'updatedAt', 'updatedAtMillis',
                     ]))))
        || isValidSelfJoin();

      // Only the owner may delete the family.
      allow delete: if isOwner();

      function isFamilyMember() {
        return request.auth != null
          && request.auth.uid in
               get(/databases/$(database)/documents/families/$(familyId))
                 .data.memberUids;
      }

      // Record version (`_v`): every save bumps it by exactly 1 (or leaves it
      // unchanged — an app version that doesn't track it), so the app can
      // tell whether its save landed on the version it last saw and detect
      // concurrent edits. A write may never set it backwards or skip ahead.
      function versionOk() {
        return !('_v' in request.resource.data)
          || (request.resource.data._v is int
              && request.resource.data._v
                   - (resource == null ? 0 : resource.data.get('_v', 0))
                 in [0, 1]);
      }

      // Every family record lives somewhere below the family doc, laid out as
      // a readable hierarchy (see lib/src/features/account/data/cloud_records.dart):
      //   settings/kitchen, finance/main/{accounts,blocks,recurring,months/
      //   {ym}/{entries,recurring}}, calendar/main/{layers,categories,imports,
      //   recurring,months/{ym}/events}, meals/{y}/months/{MM}/days/{DD},
      //   notes/{id}/lines/{lineId}, cards/{id}.
      // Each doc carries its `familyId` so the app can load a whole collection
      // id with one collection-group query (rule below). A write must stamp
      // this family's id — which also locks out outdated app versions that
      // still write the old flat layout.
      match /{sub}/{document=**} {
        allow read, delete: if isFamilyMember();
        allow create, update: if isFamilyMember() && versionOk()
          && request.resource.data.familyId == familyId;
      }
    }

    // Collection-group reads of the family record collections
    // (`collectionGroup(col).where('familyId', '==', fid)`). Writes under a
    // family require `familyId` to be that family, so the field is
    // trustworthy and membership of that family gates the read.
    match /{path=**}/{col}/{id} {
      allow read: if request.auth != null
        && col in ['settings', 'finance', 'accounts', 'blocks', 'recurring',
                   'months', 'entries', 'calendar', 'layers', 'categories',
                   'imports', 'events', 'meals', 'days', 'notes', 'lines',
                   'cards']
        && request.auth.uid in
             get(/databases/$(database)/documents/families/$(resource.data.familyId))
               .data.memberUids;
    }

    // Public handle resolver: maps a family `username` to its `familyId` so a
    // joining client can find the family doc to write to. This holds NO secret
    // material (the password hash lives only in the members-only family doc;
    // `joinSalt` is public by design — a salt only needs to be unique, not
    // secret), so any signed-in user may `get` a handle they already know.
    // `list` is deliberately NOT granted (`allow read` would include it): the
    // join flow only ever does a targeted lookup, and enumerating the whole
    // collection would expose every family's handle, id and salt (#364).
    // Writes are restricted to the owner of the referenced family, and the
    // handle id must match the family doc's own `username` so nobody can squat
    // an unrelated name and phish joins onto their family (issue: security M3).
    match /family_handles/{username} {
      allow get: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.familyId is string
        && get(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.ownerUid
             == request.auth.uid
        && get(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.username
             == username;

      // Update must satisfy the same target-consistency rules as create: the
      // caller owns the CURRENT family, and if `familyId` is retargeted they
      // must own the new family too and the handle must match its username —
      // otherwise an owner of handle X could repoint it at someone else's
      // family to phish joins.
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/families/$(resource.data.familyId)).data.ownerUid
             == request.auth.uid
        && (request.resource.data.familyId == resource.data.familyId
            || (get(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.ownerUid
                  == request.auth.uid
                && get(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.username
                  == username));

      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/families/$(resource.data.familyId)).data.ownerUid
             == request.auth.uid;
    }

    // Deprecated single-user blob, kept for migration/back-compat only.
    match /user_workspaces/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
