rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user document: profile, the families they belong to and view state.
    // Strictly owner-only.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Shared family workspace. `memberUids` is the source of truth for access.
    match /families/{familyId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function uid() {
        return request.auth.uid;
      }
      function isMember() {
        return isSignedIn()
          && resource.data.memberUids is list
          && uid() in resource.data.memberUids;
      }
      function isOwner() {
        return isSignedIn() && resource.data.ownerUid == uid();
      }

      // Members can read the shared workspace.
      allow read: if isMember();

      // Create: the creator must be the owner and a member of their new family.
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.memberUids is list
        && uid() in request.resource.data.memberUids;

      // Update is for EXISTING members only (editing the shared workspace,
      // members list, profile). Ownership and the username handle cannot be
      // changed here. A member may also leave by removing only themselves.
      //
      // SECURITY: there is deliberately NO client path to add yourself to a
      // family you are not already in. Joining is gated by the `joinFamily`
      // Cloud Function, which verifies the family password server-side with
      // the Admin SDK (bypassing these rules). This prevents an attacker who
      // learns a familyId from self-adding without the password.
      allow update: if isMember()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.username == resource.data.username;

      // Only the owner may delete the family. A delete triggers the
      // `onFamilyDeleted` Function which purges the matching family_codes doc.
      allow delete: if isOwner();
    }

    // Credential resolver: maps a family username handle to its id + salted
    // password hash. This collection holds password material and is therefore
    // COMPLETELY private to the backend. All reads and writes are denied to
    // clients; only the Admin SDK (Cloud Functions) may touch it. Family
    // creation registers credentials via `createFamilyCredentials`, joining
    // verifies them via `joinFamily`, and `onFamilyDeleted` cleans them up.
    match /family_codes/{username} {
      allow read, write: if false;
    }

    // Deprecated single-user blob, kept for migration/back-compat only.
    match /user_workspaces/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
