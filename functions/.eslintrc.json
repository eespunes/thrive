{
  "root": true,
  "env": {
    "es2022": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": 2022
  },
  "extends": ["eslint:recommended", "google"],
  "rules": {
    "quotes": ["error", "double"],
    "max-len": ["error", {"code": 100}],
    "require-jsdoc": "off",
    "valid-jsdoc": "off"
  }
}
