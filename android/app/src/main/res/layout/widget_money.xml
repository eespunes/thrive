<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/money_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/widget_bg_gradient" android:padding="15dp">
    <TextView android:id="@+id/money_header" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="10sp"
        android:textStyle="bold" android:letterSpacing="0.05"
        android:textColor="#E6FFFFFF"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="bottom" android:layout_marginTop="4dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/money_balance" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="24sp"
                android:textStyle="bold" android:textColor="#FFFFFFFF"/>
            <TextView android:id="@+id/money_sub" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="11sp"
                android:textColor="#E6FFFFFF"/>
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/money_due_label" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="10sp"
                android:textStyle="bold" android:textColor="#CCFFFFFF"/>
            <TextView android:id="@+id/money_due" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="13sp"
                android:textStyle="bold" android:textColor="#FFFFFFFF"/>
        </LinearLayout>
    </LinearLayout>
    <ProgressBar android:id="@+id/money_progress" android:layout_width="match_parent"
        android:layout_height="6dp" style="?android:attr/progressBarStyleHorizontal"
        android:layout_marginTop="11dp" android:progressTint="#FFFFFFFF"
        android:progressBackgroundTint="#48FFFFFF"/>
</LinearLayout>
